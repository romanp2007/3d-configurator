{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // noUnusedLocals/noUnusedParameters НЕ включены: с Этапа 6/7 плана
    // 3d_configurator_integration.md client/src транзитивно импортирует
    // большие куски wgpu_utils/src (@wgpu/*) — соседний проект со своим,
    // более мягким tsconfig (без этих флагов). Держать их включёнными
    // означало бы либо чистить чужой dead code по ходу дела, либо блокировать
    // сборку клиента им. Для СОБСТВЕННОГО кода 3d-configurator неиспользуемые
    // переменные по-прежнему ловит ESLint (см. ../.eslintrc.cjs), который
    // не сканирует файлы за пределами этого workspace.

    /* Path aliases — TS 6.0 deprecated baseUrl (TS5101); paths resolve
       relative to this file's directory without it. */
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@wgpu/*": ["../../src/*"],
      "@kesf-fitting/*": ["../../kesf_fitting/*"]
    },
    "types": ["@webgpu/types"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
